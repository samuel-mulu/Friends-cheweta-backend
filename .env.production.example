# Production template for Render (Web Service environment variables)
# Copy values into Render Dashboard → friends-game-api → Environment
# Do NOT commit real secrets to git.

NODE_ENV=production
# Render sets PORT automatically; local prod smoke tests can use 5000.
PORT=5000

# Runtime connection — Neon POOLER URL (hostname contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Migrations only — Neon DIRECT URL (same host WITHOUT "-pooler")
# Required for: npx prisma migrate deploy (Render releaseCommand)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# If using Render Redis from render.yaml, REDIS_URL is injected automatically.
# If using Upstash instead, paste rediss://... here and remove the Render Redis service.
REDIS_URL=redis://red-xxxxx:6379

REDIS_KEY_PREFIX=friends-game-prod
REDIS_RUNTIME_TTL_SECONDS=86400
REDIS_COMMAND_TTL_SECONDS=86400
REDIS_PRESENCE_TTL_SECONDS=90
REDIS_MATCHMAKING_TTL_SECONDS=600
REDIS_LOCK_TTL_MS=5000

JWT_ACCESS_SECRET=generate-at-least-32-random-characters-for-production
JWT_REFRESH_SECRET=generate-another-32plus-random-characters-for-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated HTTPS origins (no trailing slash)
# Vercel admin + Flutter web host if you deploy web builds
CORS_ORIGINS=https://your-admin.vercel.app

LUDO_MAX_CONSECUTIVE_TIMEOUTS=3
LUDO_DISCONNECT_GRACE_SECONDS=90
LUDO_READY_NO_SHOW_SECONDS=180

ADMIN_FULL_NAME=Friends Admin
ADMIN_PHONE=251911000000
ADMIN_PASSWORD=change-this-before-production
