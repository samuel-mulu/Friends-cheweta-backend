NODE_ENV=development
PORT=5000

# Local Postgres (docker-compose) or Neon pooler URL for runtime queries
DATABASE_URL=postgresql://game_user:game_password@localhost:5432/friends_game

# Optional locally; required on Neon production for prisma migrate deploy
# Use direct host (no "-pooler" segment). Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=postgresql://game_user:game_password@localhost:5432/friends_game

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Use * in development to allow any origin (required for Flutter web random ports).
# In production, set explicit comma-separated origins instead.
CORS_ORIGINS=*

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=friends-game
REDIS_RUNTIME_TTL_SECONDS=86400
REDIS_COMMAND_TTL_SECONDS=86400
REDIS_PRESENCE_TTL_SECONDS=90
REDIS_MATCHMAKING_TTL_SECONDS=600
REDIS_LOCK_TTL_MS=5000

# B14 realtime timeout policy
LUDO_MAX_CONSECUTIVE_TIMEOUTS=3
LUDO_DISCONNECT_GRACE_SECONDS=90
LUDO_READY_NO_SHOW_SECONDS=180

ADMIN_FULL_NAME=Friends Admin
ADMIN_PHONE=251911000000
ADMIN_PASSWORD=change-this-admin-password
