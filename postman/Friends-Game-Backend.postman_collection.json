{
  "info": {
    "_postman_id": "friends-game-backend-b0-b20",
    "name": "Friends Game Backend",
    "description": "Full REST API collection for Friends Game Backend (NestJS).\n\n**Setup**\n1. Import this collection.\n2. Default `baseUrl` is `http://localhost:5000/api` (change if your PORT differs).\n3. Run **Auth → Admin Login** (or Register + Login) — tokens are saved automatically.\n4. All protected requests use `Authorization: Bearer {{accessToken}}`.\n\n**Seeded admin:** phone `251911000000`, password `change-this-admin-password`\n\n**Notes**\n- Amounts are minor units as digit strings (e.g. `\"1000\"` = 10.00 ETB).\n- Deposit/withdrawal `idempotencyKey` must be unique per operation.\n- Matchmaking & Ludo gameplay use WebSocket namespace `/game` (not included as REST).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "matchId", "value": "" },
    { "key": "gameModeId", "value": "" },
    { "key": "depositId", "value": "" },
    { "key": "withdrawalId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "targetUserId", "value": "" },
    { "key": "riskFlagId", "value": "" },
    { "key": "gameModeAdminId", "value": "" }
  ],
