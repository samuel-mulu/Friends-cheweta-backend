    {
      "name": "Auth",
      "description": "Public endpoints — no Bearer token required.",
      "item": [
        {
          "name": "Register Player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "  if (json.user && json.user.id) pm.collectionVariables.set('userId', json.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Player\",\n  \"phoneNumber\": \"0911223344\",\n  \"password\": \"password123\",\n  \"deviceName\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Register a new player. Phone is normalized to Ethiopian format server-side."
