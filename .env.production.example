NODE_ENV=production
PORT=4000

# Postgres image settings. Not read by Nest. The user, password, and database
# must match DATABASE_URL. URL-encode the password if it contains reserved characters.
POSTGRES_USER=game_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=friends_game

DATABASE_URL=postgresql://game_user:CHANGE_ME@postgres:5432/friends_game
# Same direct URL. There is no external pooler on this VPS.
DIRECT_DATABASE_URL=postgresql://game_user:CHANGE_ME@postgres:5432/friends_game
DATABASE_POOL_MAX=15

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Browser origin of the admin app. Native Flutter does not use this list.
CORS_ORIGINS=https://admin.example.com

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=friends-game
REDIS_RUNTIME_TTL_SECONDS=86400
REDIS_COMMAND_TTL_SECONDS=86400
REDIS_PRESENCE_TTL_SECONDS=90
REDIS_LOCK_TTL_MS=5000

LUDO_MAX_CONSECUTIVE_TIMEOUTS=3
LUDO_DISCONNECT_GRACE_SECONDS=90
LUDO_READY_NO_SHOW_SECONDS=180
PREMATCH_ORPHAN_TIMEOUT_SECONDS=600
