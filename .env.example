NODE_ENV=development
PORT=5000

# Local Postgres (docker-compose) or Neon pooler URL for runtime queries
DATABASE_URL=postgresql://game_user:game_password@localhost:5432/friends_game

# Optional locally; required on Neon production for prisma migrate deploy
# Use direct host (no "-pooler" segment). Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=postgresql://game_user:game_password@localhost:5432/friends_game

# DB7: explicit Postgres pool ceiling (node-postgres default would otherwise be 10).
# Integer, 2-30, default 15.
DATABASE_POOL_MAX=15

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Use * in development to allow any origin (required for Flutter web random ports).
# In production, set explicit comma-separated origins instead.
CORS_ORIGINS=*

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=friends-game
REDIS_RUNTIME_TTL_SECONDS=86400
REDIS_COMMAND_TTL_SECONDS=3600
REDIS_PRESENCE_TTL_SECONDS=90
REDIS_LOCK_TTL_MS=5000

# B14 realtime timeout policy
GAME_MAX_CONSECUTIVE_TIMEOUTS=3
GAME_DISCONNECT_GRACE_SECONDS=90
GAME_READY_NO_SHOW_SECONDS=180
# Abandoned CREATED/WAITING open commitments older than this are cancelled/refunded.
# Only legacy open matches can be in these states; challenge matches are created READY.
PREMATCH_ORPHAN_TIMEOUT_SECONDS=600

# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 = clients connect directly).
TRUST_PROXY_HOPS=0

# Cheweta payments and SMS. Keep credentials on the backend.
DEPOSIT_APPROVAL_PIN=
CBE_SETTLEMENT_ACCOUNT=
CBE_RECEIVER_NAME=
TELEBIRR_SETTLEMENT_ACCOUNT=
TELEBIRR_RECEIVER_NAME=
AWASH_SETTLEMENT_ACCOUNT=
AWASH_RECEIVER_NAME=
BOA_SETTLEMENT_ACCOUNT=
BOA_RECEIVER_NAME=
# Optional overrides for banks that require a receipt-account suffix.
CBE_ACCOUNT_SUFFIX=
BOA_ACCOUNT_SUFFIX=
VERIFY_ET_BASE_URL=https://verify.et
VERIFY_ET_API_KEY=
# Full HTTPS endpoint ending in /receipt on the Cheweta receipt verifier.
TELEBIRR_VERIFIER_URL=
TELEBIRR_VERIFIER_TOKEN=

GEEZSMS_ENABLED=false
GEEZSMS_BASE_URL=https://api.geezsms.com/api/v1
GEEZSMS_TOKEN=
GEEZSMS_API_KEY=
GEEZSMS_BILLING_ID=
GEEZSMS_SHORTCODE_ID=
GEEZSMS_CALLBACK_URL=
GEEZSMS_CALLBACK_SECRET=
WITHDRAWAL_ADMIN_SMS_PHONES=
