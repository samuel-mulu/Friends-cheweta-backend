NODE_ENV=production
PORT=4000

# Postgres image settings. Not read by Nest. The user, password, and database
# must match DATABASE_URL. URL-encode the password if it contains reserved characters.
POSTGRES_USER=game_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=friends_game

DATABASE_URL=postgresql://game_user:CHANGE_ME@postgres:5432/friends_game
# Same direct URL. There is no external pooler on this VPS.
DIRECT_DATABASE_URL=postgresql://game_user:CHANGE_ME@postgres:5432/friends_game
DATABASE_POOL_MAX=15

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Browser origin of the admin app. Native Flutter does not use this list.
CORS_ORIGINS=https://admin.example.com

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=friends-game
REDIS_RUNTIME_TTL_SECONDS=86400
REDIS_COMMAND_TTL_SECONDS=3600
REDIS_PRESENCE_TTL_SECONDS=90
REDIS_LOCK_TTL_MS=5000

GAME_MAX_CONSECUTIVE_TIMEOUTS=3
GAME_DISCONNECT_GRACE_SECONDS=90
GAME_READY_NO_SHOW_SECONDS=180
PREMATCH_ORPHAN_TIMEOUT_SECONDS=600

# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 = clients connect directly).
TRUST_PROXY_HOPS=1

# Cheweta payments and SMS. Keep credentials on the backend.
DEPOSIT_APPROVAL_PIN=
CBE_SETTLEMENT_ACCOUNT=
CBE_RECEIVER_NAME=
TELEBIRR_SETTLEMENT_ACCOUNT=
TELEBIRR_RECEIVER_NAME=
AWASH_SETTLEMENT_ACCOUNT=
AWASH_RECEIVER_NAME=
BOA_SETTLEMENT_ACCOUNT=
BOA_RECEIVER_NAME=
# Optional overrides for banks that require a receipt-account suffix.
CBE_ACCOUNT_SUFFIX=
BOA_ACCOUNT_SUFFIX=
VERIFY_ET_BASE_URL=https://verify.et
VERIFY_ET_API_KEY=
# Full HTTPS endpoint ending in /receipt on the Cheweta receipt verifier.
TELEBIRR_VERIFIER_URL=
TELEBIRR_VERIFIER_TOKEN=

GEEZSMS_ENABLED=false
GEEZSMS_BASE_URL=https://api.geezsms.com/api/v1
GEEZSMS_TOKEN=
GEEZSMS_API_KEY=
GEEZSMS_BILLING_ID=
GEEZSMS_SHORTCODE_ID=
GEEZSMS_CALLBACK_URL=
GEEZSMS_CALLBACK_SECRET=
WITHDRAWAL_ADMIN_SMS_PHONES=
